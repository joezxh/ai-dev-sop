[Unit]
Description=cbmem-team HTTP wrapper + Console (MySQL backend)
Documentation=https://docs/superpowers/specs/2026-07-11-cbmem-team-v2-research.md
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=cbmem
Group=cbmem
# Load DSN from a secrets file (mode 0600, owned by cbmem). systemd
# EnvironmentFile does NOT inline-expand shell, so secrets must be raw
# KEY=VALUE pairs.
EnvironmentFile=/etc/cbmem-team/mysql.env
ExecStart=/usr/local/bin/cbmem-team \
  -listen :8787 \
  -data /var/lib/cbmem-team \
  -mcp-bin /usr/local/bin/codebase-memory-mcp \
  -jwt-secret /run/secrets/cbmem-jwt-secret \
  -admin-token /run/secrets/cbmem-admin-token \
  -mysql-dsn ${CBMEM_MYSQL_DSN} \
  -mysql-max-open ${CBMEM_MYSQL_MAX_OPEN} \
  -mysql-max-idle ${CBMEM_MYSQL_MAX_IDLE} \
  -mysql-max-lifetime ${CBMEM_MYSQL_MAX_LIFETIME} \
  -llm-provider openai \
  -llm-model gpt-4o-mini \
  -llm-base-url https://api.openai.com/v1 \
  -llm-api-key /run/secrets/cbmem-llm-api-key \
  -mempalace-base http://192.168.100.83:8089 \
  -console-dist /opt/cbmem-console/dist \
  -log info
Restart=always
RestartSec=5
# 7-day rollback window: keep the legacy SQLite DB reachable. To roll
# back, drop the -mysql-dsn flag and start with cbmem-team-sqlite.service
# (deploy/cbmem-team-sqlite.service).

[Install]
WantedBy=multi-user.target