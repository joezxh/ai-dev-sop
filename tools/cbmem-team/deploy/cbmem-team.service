[Unit]
Description=cbmem-team: multi-user HTTP wrapper around codebase-memory-mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cbmem
Group=cbmem
EnvironmentFile=/etc/cbmem-team/cbmem-team.env
ExecStart=/usr/local/bin/cbmem-team \
    -listen ${LISTEN} \
    -data ${DATA_DIR} \
    -mcp-bin ${MCP_BINARY} \
    -jwt-secret ${JWT_SECRET} \
    -admin-token ${ADMIN_TOKEN} \
    -log ${LOG_LEVEL}

Restart=on-failure
RestartSec=5s

# Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
# ProtectHome=read-only keeps /home/* visible so the cbmem user can exec
# the MCP binary that lives at ${MCP_BINARY}. If your MCP binary lives in
# /usr/local/bin you can switch to ProtectHome=true for stricter isolation.
ProtectHome=read-only
ReadWritePaths=/var/lib/cbmem-team /var/log/cbmem-team
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true

# Resource limits
MemoryMax=512M
TasksMax=256
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target