# cbmem-team — dev environment defaults
#
# Copy to .env (or `set -a; source .env; set +a` in shell) and edit values
# to match your local MySQL. The dev tools below read this via the
# internal/devconf package — no need to pass `-mysql-dsn` every time.
#
# Resolution order inside Go (first non-empty wins):
#   1. -mysql-dsn "..."                                  (flag, one-off)
#   2. $CBMEM_MYSQL_DSN                                  (this file)
#   3. $DSN                                              (legacy env name)
#   4. hard-coded localhost dev default                  (last resort)
#
# Production deployments: do NOT use this file — they should read
# /etc/cbmem-team/cbmem-team.env (see deploy/cbmem-team.env).

# --- MySQL (used by cmd/{create-db,mysql-probe,show-tables,show-indexes,e2e-*}) ---
# Default is the docker-compose stack in deploy/docker-compose.mysql.yml.
# Override only if you point at a remote MySQL or a non-default port.
CBMEM_MYSQL_DSN=root:adsop123@tcp(127.0.0.1:3306)/cbmem?parseTime=true&loc=Local&charset=utf8mb4
