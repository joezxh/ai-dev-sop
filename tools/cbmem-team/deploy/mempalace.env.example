# MemPalace 环境配置
# 复制此文件为 .env 并修改相应值
# 使用方法: docker compose --env-file .env up -d

# ========== 基础配置 ==========
# MemPalace HTTP 端口
MEMPALACE_PORT=8089

# ========== 存储后端配置 ==========
# 可选值: chroma (默认), sqlite_exact, qdrant, pgvector
MEMPALACE_BACKEND=chroma

# Qdrant 配置 (当 backend=qdrant 时)
# MEMPALACE_QDRANT_URL=http://qdrant:6333
# MEMPALACE_QDRANT_API_KEY=your_api_key

# pgvector 配置 (当 backend=pgvector 时)
# MEMPALACE_PGVECTOR_DSN=postgresql://postgres:password@pgvector:5432/mempalace

# ========== 数据持久化 ==========
# MemPalace 数据存储路径 (容器内)
# MEMPALACE_DATA_DIR=/data
