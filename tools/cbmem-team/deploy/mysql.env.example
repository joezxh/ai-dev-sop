# cbmem-team MySQL · 环境变量模板
# 复制本文件为 .env（部署到 /etc/cbmem-team/mysql.env 后 0600 权限）
#
# 生产部署务必修改所有密码为强随机串（openssl rand -hex 32）

# MySQL 服务端口（容器内固定 3306，宿主机端口可改）
MYSQL_PORT=3306

# 数据库名
MYSQL_DATABASE=cbmem

# 用户名
MYSQL_USER=cbmem

# 密码（dev 占位，生产必改）
MYSQL_PASSWORD=cbmem-dev-password

# Root 密码（dev 占位，生产必改；运维专用，不进 application 进程）
MYSQL_ROOT_PASSWORD=root-dev-password

# 给 cbmem-team 进程使用的 DSN
# 格式：user:pass@tcp(host:port)/dbname?parseTime=true&loc=Local&charset=utf8mb4&multiStatements=true
# 开发：连接宿主机 127.0.0.1
# 生产：连接内网 DNS 解析的 mysql.cbmem.internal 或独立 IP
CBMEM_MYSQL_DSN=cbmem:cbmem-dev-password@tcp(127.0.0.1:3306)/cbmem?parseTime=true&loc=Local&charset=utf8mb4&multiStatements=true

# 连接池配置
CBMEM_MYSQL_MAX_OPEN=16
CBMEM_MYSQL_MAX_IDLE=4
CBMEM_MYSQL_MAX_LIFETIME=30m