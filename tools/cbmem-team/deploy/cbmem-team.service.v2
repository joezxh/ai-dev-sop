[Unit]
Description=cbmem-team: multi-user HTTP wrapper around codebase-memory-mcp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cbmem
Group=cbmem
EnvironmentFile=/etc/cbmem-team/cbmem-team.env
ExecStart=/usr/local/bin/cbmem-team -listen :8787 -data /var/lib/cbmem-team -mcp-bin /home/tianque/codebase-memory-mcp -jwt-secret $JWT_SECRET -admin-token $ADMIN_TOKEN -log info
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/cbmem-team /var/log/cbmem-team
# codebase-memory-mcp binary lives under /home/tianque; allow cbmem user to exec it.
# Read-only bind mount would be safer in production.
BindPaths=/home/tianque/codebase-memory-mcp
PrivateTmp=true
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target