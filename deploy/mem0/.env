# PostgreSQL (本地 mwb-postgres-pgvector 容器)
POSTGRES_PASSWORD=admin123

# Neo4j (本地 mwb-neo4j 容器)
NEO4J_URI=bolt://mwb-neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j123

# Auth (本地开发关闭认证)
AUTH_DISABLED=false
JWT_SECRET=local-dev-jwt-secret-key-2026

# LLM (后续配置，暂留空 - 提供临时值让服务启动)
OPENAI_API_KEY=sk-placeholder-for-startup-only

# ---- Graph memory (self-built, 1.x aligned) ----
GRAPH_ENABLED=true
GRAPH_THRESHOLD=0.7
GRAPH_CUSTOM_PROMPT=
