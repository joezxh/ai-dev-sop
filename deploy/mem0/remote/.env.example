# =============================================================
# Mem0 远程部署 .env 示例
#
# 用法：复制为 .env 并填入真实值
#   cp .env.example .env
#
# 默认值已按"自带数据库"模式写好（POSTGRES_HOST / NEO4J_URI 指向
# docker-compose.yaml 里的 mem0-postgres / mem0-neo4j 容器）。
# 若改用外部数据库，改这两项并删除 compose 中的对应服务即可。
# =============================================================

# ---- PostgreSQL（远程 compose 自带 mem0-postgres 容器）----
POSTGRES_HOST=mem0-postgres
POSTGRES_PORT=5432
POSTGRES_DB=mem0
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_COLLECTION_NAME=memories
APP_DB_NAME=mem0_app

# ---- Neo4j（远程 compose 自带 mem0-neo4j 容器）----
NEO4J_URI=bolt://mem0-neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_this_neo4j_password
GRAPH_ENABLED=true
GRAPH_THRESHOLD=0.7

# ---- 鉴权（生产务必设 AUTH_DISABLED=false 并配置 JWT_SECRET）----
AUTH_DISABLED=false
JWT_SECRET=please_change_to_a_long_random_string

# ---- 遥测 / 行为 ----
MEM0_TELEMETRY=false
DASHBOARD_URL=*

# ---- LLM / Embedder（改成你实际订阅的模型与端点）----
# OPENAI_BASE_URL 必须能在服务器上访问（容器内 LLM 调用走这个地址）
OPENAI_BASE_URL=https://your-llm-endpoint/v1
OPENAI_API_KEY=sk-your-real-api-key
MEM0_DEFAULT_LLM_MODEL=qwen-plus
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-v4
MEM0_DEFAULT_EMBEDDER_DIMS=1024
MEM0_EMBEDDER_SEND_DIMENSIONS=false

# ---- 容器内部路径（一般无需修改）----
MEM0_DIR=/app/data
HISTORY_DB_PATH=/app/data/history.db
MEM0_API_URL=http://localhost:8000
MEM0_MCP_PORT=8080
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
