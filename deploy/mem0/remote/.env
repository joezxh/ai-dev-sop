# =============================================================
# Mem0 远程部署 .env（外部数据库模式）
# 数据库/图库使用你提供的外部实例 192.168.100.80
# =============================================================

# ---- PostgreSQL（外部实例 192.168.100.80）----
POSTGRES_HOST=192.168.100.80
POSTGRES_PORT=5432
POSTGRES_DB=mem0
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres@2026!
POSTGRES_COLLECTION_NAME=memories
APP_DB_NAME=mem0

# ---- Neo4j（外部实例 192.168.100.80）----
NEO4J_URI=bolt://192.168.100.80:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4j@2026!
GRAPH_ENABLED=true
GRAPH_THRESHOLD=0.7

# ---- 鉴权（生产务必设 AUTH_DISABLED=false 并配置 JWT_SECRET）----
AUTH_DISABLED=false
JWT_SECRET=please_change_to_a_long_random_string
# 引导管理员密钥：与本地 mem0 配置共用同一把 m0sk_ 密钥，
# 使本机 CodeBuddy 的 mem0-tianque MCP（X-API-Key）可直接访问远程 API。
ADMIN_API_KEY=m0sk_bIlWM3UcRK_TEs0bA_digbbqjcGLhVLKvkTWFjdLoig

# ---- 遥测 / 行为 ----
MEM0_TELEMETRY=false
DASHBOARD_URL=*

# ---- LLM / Embedder（请按实际端点/密钥修改）----
# 容器直连 LLM 端点，不走系统代理；NO_PROXY 已放行 192.168.40.30。
# 下面是占位值，请改成你真实可用的 LLM 网关与模型。
OPENAI_BASE_URL=http://192.168.40.30/v1
OPENAI_API_KEY=sk-your-real-api-key
MEM0_DEFAULT_LLM_MODEL=qwen-plus
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-v4
MEM0_DEFAULT_EMBEDDER_DIMS=1024
MEM0_EMBEDDER_SEND_DIMENSIONS=false

# ---- 代理豁免（直连内网 LLM 端点）----
NO_PROXY=localhost,127.0.0.1,192.168.40.30
no_proxy=localhost,127.0.0.1,192.168.40.30

# ---- 容器内部路径（一般无需修改）----
MEM0_DIR=/app/data
HISTORY_DB_PATH=/app/data/history.db
MEM0_API_URL=http://localhost:8000
MEM0_MCP_PORT=8080
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
